### Server Components

Explicitly mark server components and document data fetching:

```typescript
/**
 * Product listing page with server-side data fetching.
 *
 * Server Component - fetches at request time.
 * Supports pagination via 'page' param and filtering via 'category'.
 *
 * @example
 * ```tsx
 * // app/products/page.tsx
 * export default async function Page({ searchParams }: PageProps) {
 *   return <ProductsPage searchParams={searchParams} />
 * }
 * ```
 */
export async function ProductsPage({ searchParams }: ProductsPageProps) {
  const products = await fetchProducts(searchParams)
  return <ProductList products={products} />
}
```

### Client Components

Mark clearly and document browser dependencies:

```typescript
/**
 * Interactive carousel with touch gestures and auto-play.
 *
 * Client Component - requires browser APIs for touch events.
 * Uses Framer Motion for animations.
 *
 * @param images - Array of image URLs
 * @param autoPlay - Enable auto-advance every 5s (default: false)
 * @param onImageClick - Optional callback when image clicked
 *
 * @example
 * ```tsx
 * "use client"
 * 
 * <ImageCarousel 
 *   images={product.images} 
 *   autoPlay={true}
 *   onImageClick={(idx) => openLightbox(idx)}
 * />
 * ```
 */
"use client"

export function ImageCarousel({ images, autoPlay = false, onImageClick }: CarouselProps) {
  // Implementation
}
```

