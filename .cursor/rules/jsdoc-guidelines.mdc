## Types

Document complex types with constraints:

```typescript
/**
 * API request configuration with automatic retry logic.
 *
 * @property url - API endpoint (must start with '/')
 * @property method - HTTP method (default: 'GET')
 * @property retries - Retry attempts on failure (0-5, default: 3)
 * @property timeout - Request timeout in ms (default: 5000)
 * @property onRetry - Callback before each retry
 *
 * @example
 * ```ts
 * const config: APIRequestConfig = {
 *   url: '/api/users',
 *   method: 'POST',
 *   retries: 2,
 *   onRetry: (attempt) => console.log(`Retry ${attempt}`)
 * }
 * ```
 */
export type APIRequestConfig = {
  url: string
  method?: 'GET' | 'POST' | 'PUT' | 'DELETE'
  retries?: number
  timeout?: number
  onRetry?: (attempt: number) => void
}
```

