## Runtime Components

Components with side effects but no UI:

```typescript
/**
 * GSAP Runtime
 *
 * Syncs GSAP ticker with Tempus for consistent frame timing.
 * Mount once in root layout. Returns null (no UI).
 *
 * @example
 * ```tsx
 * // app/layout.tsx
 * import { GSAPRuntime } from '@/components/effects/gsap'
 *
 * <body>
 *   <GSAPRuntime />
 *   {children}
 * </body>
 * ```
 */
export function GSAPRuntime() {
  useTempus((time) => gsap.updateRoot(time / 1000))
  return null
}
```

