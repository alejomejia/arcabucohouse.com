# ============================================
# Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values
# Run: cp .env.example .env.local
# ============================================

# ============================================
# CORE
# ============================================

# Base URL for the site (used for SEO, canonical URLs, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# For metadata generation
SITE_NAME="Your website name"

# ============================================
# SHOPIFY
# E-commerce platform with cart and checkout
# Get credentials: https://shopify.dev/docs/storefronts/headless
# ============================================

# Required for Shopify
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_API_TOKEN=""

# For revalidation webhooks
SHOPIFY_REVALIDATION_SECRET=""

# Optional - for customer accounts
SHOPIFY_CUSTOMER_ACCOUNT_API_TOKEN=""

# ============================================
# MAILCHIMP
# Email marketing and newsletters
# Get credentials: https://mailchimp.com/developer/
# ============================================

# Required for Mailchimp
MAILCHIMP_API_KEY=""
MAILCHIMP_SERVER_PREFIX=""
MAILCHIMP_AUDIENCE_ID=""

# ============================================
# ANALYTICS
# ============================================

# Umami for cookieless tracking and events
UMAMI_WEBSITE_ID=""